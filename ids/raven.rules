# raven IDS rules — targeted at the actual threat model: an infected network
# injecting reverse shells / C2 payloads / exploit traffic on the hotseat.
# sids 9xxxxxx stay local (never collide with emerging/registered sets).

alert tcp any any -> $HOME_NET any (msg:"RAVEN reverse-shell /dev/tcp inbound"; flow:to_client,established; content:"/dev/tcp/"; classtype:shellcode-detect; sid:9000001; rev:1;)

alert tcp $HOME_NET any -> any any (msg:"RAVEN reverse-shell bash -i outbound"; flow:to_server,established; content:"bash -i"; nocase; classtype:shellcode-detect; sid:9000002; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"RAVEN reverse-shell bash -i inbound"; flow:to_client,established; content:"bash -i"; nocase; classtype:shellcode-detect; sid:9000003; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"RAVEN meterpreter payload"; flow:to_client,established; content:"meterpreter"; nocase; classtype:shellcode-detect; sid:9000004; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"RAVEN nc -e /bin/sh payload"; flow:to_client,established; content:"nc -e"; content:"/bin/sh"; classtype:shellcode-detect; sid:9000005; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"RAVEN metasploit staging payload"; flow:to_client,established; content:"MZ"; within:2; content:"msf"; nocase; classtype:shellcode-detect; sid:9000006; rev:1;)